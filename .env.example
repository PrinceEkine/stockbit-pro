# ---------------------------------------------------------------------------
# Browser (public) configuration — only VITE_* variables are bundled.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Paystack PUBLIC key (pk_live_... / pk_test_...). The secret key is NEVER used here.
VITE_PAYSTACK_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Server-only secrets — set with `supabase secrets set ...`, NOT in this file.
#   PAYSTACK_SECRET_KEY   (verify-payment)
#   GEMINI_API_KEY        (ai-gateway)
#   QWEN_API_KEY          (ai-gateway, optional)
# ---------------------------------------------------------------------------
